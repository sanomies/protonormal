{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "band-practice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    // The SPA handles all routing; only /api/* may reach the Worker, otherwise
    // the asset server would swallow WebSocket upgrade requests with index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
